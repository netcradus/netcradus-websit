# =================================================================
# NETCRADUS BACKEND CONFIGURATION (.env)
# =================================================================

# Server Port and Runtime Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=netcradus_db
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Connection Pool Options
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true

# Security & CORS Whitelist (Comma-separated origins)
ALLOWED_ORIGINS=https://aus.netcradus.com,https://netcradus.in,https://netcradus.co.uk.com,http://localhost:5173

# Cloudflare Turnstile CAPTCHA Secret Key (Server-Only Secret)
# For AWS Production: CAPTCHA_SECRET_KEY must be supplied through AWS Secrets Manager / secure ECS container environment configuration.
CAPTCHA_SECRET_KEY=

# Google Sheets Integration
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Sheet1
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./.secrets/google-service-account.json

# DPDP Data Retention Policy (Inquiry expiration in days, default: 365)
CONTACT_RETENTION_DAYS=365
